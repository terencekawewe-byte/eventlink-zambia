# Copy this file to .env and replace every placeholder with a long random value.
# Never commit .env or use these placeholders in a running application.

SECRET_KEY=replace-with-a-long-random-string
SIMULATION_WEBHOOK_SECRET=replace-with-another-long-random-string
PAYMENT_WEBHOOK_SECRET=

# simulation or live
PAYMENT_MODE=simulation

# Set to 1 only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Set to 1 only on your own computer while developing.
FLASK_DEBUG=0

PORT=5000

# 127.0.0.1 keeps the site on this computer only. Use 0.0.0.0 to let phones on the
# same Wi-Fi open it (for gate attendants scanning tickets). See "Ticket scanning on a
# local network" in README.md.
HOST=127.0.0.1

# Phone browsers only allow the camera over HTTPS. Point these at a certificate and key
# (for example made with mkcert) to serve HTTPS. Leave both empty for plain HTTP.
SSL_CERT_FILE=
SSL_KEY_FILE=
