# Copy this file to .env and replace every placeholder with a long random value.
# Never commit .env or use these placeholders in a running application.

SECRET_KEY=replace-with-a-long-random-string
SIMULATION_WEBHOOK_SECRET=replace-with-another-long-random-string
PAYMENT_WEBHOOK_SECRET=

# simulation or live
PAYMENT_MODE=simulation

# Set to 1 only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Set to 1 only on your own computer while developing.
FLASK_DEBUG=0

PORT=5000
